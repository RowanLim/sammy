# ── 密钥，永不进仓库 ──
.env
.env.*
!.env.example
*.key
*_key.txt
secrets/

# ── macOS ──
.DS_Store
._*

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
myenv/
*.egg-info/

# ── Node ──
node_modules/
dist/
build/

# ── 运行时产物 ──
logs/
*.log
*.db
*.sqlite
__history__/

# ── 这个项目的一切都在项目文件夹里（Rowan 的隔离要求）──
# data/    记忆库、驱力/心跳/休息状态、.env（凭证）
# backups/ 本地备份产物
# .tmp/    临时中间文件
# 三个都**不进版本库**：里面是私人数据和凭证。
data/
backups/
.tmp/

# ── 模型（几百 MB，不进版本库；用 scripts/fetch_models.sh 重新下）──
# 唤醒词（中/英文）、语音识别（paraformer）、VAD
models/
.tmp/kws-*.tar.bz2
.tmp/asr.tar.bz2

# ── 测试与覆盖率产物 ──
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/

# 压测报告 v2（带 rss_series_mb 与 replay / replica 两节）—— 每次跑都不一样，
# 不入库；docs/soak-report.json 是 2026-10-01 那份旧格式的历史留存，留着。
docs/soak-report-1h.json
