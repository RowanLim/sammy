# 复制成 .env 再填自己的值。.env 已被 git 忽略，永不进仓库。
# 改完用 `./run.sh --models` 看各档位状态。

# ══════════════════════════════════════════════════
#  CHAT 档 —— 聊天 + 情绪标签。要「快」，用 lite 级模型
# ══════════════════════════════════════════════════
SAMMY_CHAT_API_KEY=
SAMMY_CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SAMMY_CHAT_MODEL=doubao-seed-2-0-lite-260215

# ══════════════════════════════════════════════════
#  AGENT 档 —— 调工具 / 多步推理 / 记忆整理。要「会想」
#  任何 OpenAI 兼容接口都行，换供应商只改这里，不改代码。
#  例：DeepSeek -> https://api.deepseek.com/v1 ，模型 deepseek-chat
# ══════════════════════════════════════════════════
SAMMY_AGENT_API_KEY=
SAMMY_AGENT_BASE_URL=
SAMMY_AGENT_MODEL=

# ══════════════════════════════════════════════════
#  兼容旧配置：没有 SAMMY_CHAT_* 时，CHAT 档回落到下面这三个
# ══════════════════════════════════════════════════
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-0-lite-260215

# 思考链开关：off（默认，快） / on（慢 3-5 秒，但想得更深）
SAMMY_THINKING=off
